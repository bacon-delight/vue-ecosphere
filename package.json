{
	"name": "vue-ecosphere-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "Workspace root for vue-ecosphere",
	"engines": {
		"node": ">=20",
		"pnpm": ">=9"
	},
	"packageManager": "pnpm@9.12.3",
	"scripts": {
		"dev": "pnpm --filter @vue-ecosphere/docs dev",
		"build": "pnpm --filter vue-ecosphere build && pnpm --filter @vue-ecosphere/docs build",
		"build:lib": "pnpm --filter vue-ecosphere build",
		"build:docs": "pnpm --filter @vue-ecosphere/docs build",
		"test": "pnpm -r --if-present test",
		"type-check": "pnpm -r --if-present type-check",
		"lint": "eslint . --fix",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,vue,scss,md,json,yaml,yml}\"",
		"size": "pnpm --filter vue-ecosphere size",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "pnpm build:lib && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.9",
		"@eslint/js": "^9.14.0",
		"@types/node": "^22.9.0",
		"@vue/eslint-config-prettier": "^10.1.0",
		"@vue/eslint-config-typescript": "^14.1.3",
		"eslint": "^9.14.0",
		"eslint-plugin-vue": "^9.30.0",
		"npm-run-all2": "^7.0.1",
		"prettier": "^3.3.3",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.13.0",
		"vue-eslint-parser": "^9.4.3",
		"vue-tsc": "^2.1.10"
	}
}
