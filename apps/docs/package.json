{
	"name": "@vue-ecosphere/docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"docs:gen": "node scripts/gen-component-meta.mjs && node scripts/gen-tokens-ref.mjs",
		"dev": "pnpm run docs:gen && vitepress dev .",
		"build": "pnpm run docs:gen && vitepress build .",
		"preview": "vitepress preview ."
	},
	"dependencies": {
		"vue": "^3.5.12",
		"vue-ecosphere": "workspace:*"
	},
	"devDependencies": {
		"@ecosphere/tokens": "workspace:*",
		"vitepress": "^1.5.0",
		"vue-docgen-api": "^4.79.2"
	}
}
