			"md": {
				"height": { "value": "2.5rem" },
				"padding-x": { "value": "{primitive.spacing.4}" },
				"font-size": { "value": "{primitive.font.size.md}" }
			},
			"lg": {
				"height": { "value": "3rem" },
				"padding-x": { "value": "{primitive.spacing.5}" },
