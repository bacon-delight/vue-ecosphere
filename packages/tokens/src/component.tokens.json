{
	"button": {
		"radius": { "value": "{radius.base}" },
		"transition": { "value": "{transition.base}" },
		"font-family": { "value": "{font.family.base}" },
		"font-weight": { "value": "{primitive.font.weight.semibold}" },

		"size": {
			"xs": {
				"height": { "value": "1.5rem" },
